{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Daily sales by franchise",
      "queryLines": [
        "SELECT transaction_date, franchise_id, franchise_name, franchise_city, ",
        "franchise_country, payment_method, revenue, orders, units_sold ",
        "FROM daily_sales_by_franchise"
      ],
      "columns": [
        {
          "displayName": "Avg Ticket",
          "description": "Revenue per order",
          "expression": "SUM(`revenue`) / SUM(`orders`)"
        }
      ]
    },
    {
      "name": "ds_product",
      "displayName": "Sales by product",
      "queryLines": [
        "SELECT product, franchise_country, transaction_month, revenue, units_sold, orders ",
        "FROM sales_by_product"
      ]
    },
    {
      "name": "ds_franchise",
      "displayName": "Franchise performance",
      "queryLines": [
        "SELECT franchise_id, franchise_name, city, country, latitude, longitude, size, ",
        "revenue, orders, units_sold, unique_customers, avg_ticket ",
        "FROM franchise_performance ORDER BY revenue DESC"
      ]
    },
    {
      "name": "ds_sentiment",
      "displayName": "Review sentiment by country",
      "queryLines": [
        "SELECT country, franchise_name, sentiment, reviews FROM ( ",
        "SELECT country, franchise_name, ",
        "stack(4, 'positive', positive_reviews, 'mixed', mixed_reviews, ",
        "'negative', negative_reviews, 'neutral', neutral_reviews) AS (sentiment, reviews) ",
        "FROM sentiment_by_franchise) WHERE reviews > 0"
      ]
    },
    {
      "name": "ds_sentiment_franchise",
      "displayName": "Review sentiment by franchise",
      "queryLines": [
        "SELECT franchise_name, city, country, reviews, positive_reviews, negative_reviews, ",
        "positive_share FROM sentiment_by_franchise ORDER BY positive_share ASC, reviews DESC"
      ]
    }
  ],
